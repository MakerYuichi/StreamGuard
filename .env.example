# StreamGuard — environment variable reference
# Copy this file to .env and edit as needed.
# .env is gitignored and must never be committed.
#
# All variables are optional: the defaults below match the Docker Compose
# setup in infra/docker-compose.yml and work out-of-the-box on localhost.

# ── Kafka / Redpanda ──────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=raw-events

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5439
POSTGRES_DB=streamguard
POSTGRES_USER=streamguard
POSTGRES_PASSWORD=streamguard

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── WebSocket server ──────────────────────────────────────────────────────────
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8080

# ── MIDAS scorer ──────────────────────────────────────────────────────────────
# Score >= ANOMALY_THRESHOLD triggers an alert.
# See docs/deviations.md for how this maps to the MIDAS paper.
ANOMALY_THRESHOLD=3.0

# Time window length for the current-tick sketch (seconds).
TICK_LENGTH_SECONDS=10

# Count-Min Sketch dimensions.
# epsilon ≈ e/SKETCH_WIDTH ≈ 0.00136, delta ≈ e^(-SKETCH_DEPTH) ≈ 0.0067
SKETCH_WIDTH=2000
SKETCH_DEPTH=5

# Multiplicative decay applied to the total sketch at each tick boundary.
# Must be in (0, 1).  Lower values forget history faster.
HISTORY_DECAY=0.98

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Create frontend/.env.local with this variable for local dev.
# In production, set it in your deployment environment.
VITE_WS_URL=ws://localhost:8080
