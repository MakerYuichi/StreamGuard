# Dockerfile for CIC-IDS2017 Attribute Analysis
# Builds a Python environment with all ML dependencies
#
# Usage:
#   docker build -f Dockerfile.analysis -t streamguard-analysis .
#   docker run --rm -v $(pwd)/data:/app/data -v $(pwd)/results:/app/results \
#       streamguard-analysis python scripts/attribute_analysis.py

FROM python:3.12

WORKDIR /app

# Install system dependencies for building packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libopenblas-dev \
    liblapack-dev \
    gfortran \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and install wheel
RUN pip install --upgrade pip setuptools wheel

# Copy project files
COPY pyproject.toml .
COPY scripts/ scripts/
COPY streamguard/ streamguard/

# Install Python dependencies
# Install in stages to handle complex package dependencies
RUN pip install --no-cache-dir 'numpy>=1.24' 'pandas>=2.0' 'scipy>=1.12'
RUN pip install --no-cache-dir 'scikit-learn>=1.4'
RUN pip install --no-cache-dir 'matplotlib>=3.8' 'seaborn>=0.13'

# Create output directories
RUN mkdir -p /app/data /app/results

# Default command
CMD ["python", "scripts/attribute_analysis.py", \
     "--input", "data/processed/cic-ids2017.parquet", \
     "--output", "results/"]

